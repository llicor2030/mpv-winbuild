@@ -26,15 +33,1033 @@
 EXTERN_C IMAGE_DOS_HEADER __ImageBase;
 #define HINST_THISCOMPONENT ((HINSTANCE)&__ImageBase)
 
+// ---------------------------------------------------------------------------
+// Host vblank lock (presentation feedback for Win32/Vulkan)
+//
+// mpv does not own the Vulkan swapchain here and there is no Vulkan/Win32 API
+// for past presentation timing, so display-sync had no feedback on this path:
+// a vblank physically missed by the swapchain was invisible to vo.c, the A/V
+// difference did not move and neither drop_repeat nor the audio tempo loop
+// corrected it.
+//
+// Instead of guessing when a frame was shown, pin down when it is shown:
+//  - A watcher thread waits on the real scan-out vblank of the window's
+//    monitor (D3DKMTWaitForVerticalBlankEvent) and keeps a vblank index plus a
+//    smoothed phase/period estimate (phase follows quickly, period follows
+//    ppm-level drift very slowly).
+//  - After each present, swap_buffers blocks until the first vblank after the
+//    present, so the VO advances exactly one vblank per swap.
+//  - get_vsync reports that vblank's time. A late present lands on a later
+//    vblank, the reported spacing becomes 2+ periods, vo.c's skip detection
+//    fires and display-sync sees the slip in the A/V difference.
+//
+// With vulkan-swap-mode=mailbox and swapchain-depth=1 the mapping is exact:
+// libplacebo's swap_buffers returns only after the frame's GPU work finished,
+// and mailbox latches the newest ready image at the next vblank. With FIFO the
+// wait does not double up (FIFO consumes one image per vblank, we submit one per
+// vblank), but the image may reach the screen a vblank later than reported.
+//
+// Only the timing is taken from the host; nothing is changed about what is
+// rendered. If the vblank API is unavailable or the estimate is not settled,
+// no feedback is reported and vo.c keeps its fallback behaviour.
+// ---------------------------------------------------------------------------
+
+// D3DKMT (gdi32.dll exports), declared locally to avoid depending on
+// d3dkmthk.h. D3DKMT_HANDLE is a UINT.
+struct vbl_kmt_open {
+    HDC hDc;
+    UINT hAdapter;
+    LUID AdapterLuid;
+    UINT VidPnSourceId;
+};
+
+struct vbl_kmt_wait {
+    UINT hAdapter;
+    UINT hDevice;
+    UINT VidPnSourceId;
+};
+
+struct vbl_kmt_close {
+    UINT hAdapter;
+};
+
+typedef LONG (APIENTRY *vbl_open_fn)(struct vbl_kmt_open *);
+typedef LONG (APIENTRY *vbl_wait_fn)(const struct vbl_kmt_wait *);
+typedef LONG (APIENTRY *vbl_close_fn)(const struct vbl_kmt_close *);
+
+#define VBL_NS_PER_MS 1e6
+
+// Host vblank estimate. Times are mp_time_ns() values held as double.
+struct vbl_est {
+    uint64_t seq;       // index of the vblank at `phase`
+    double phase;       // estimated time of vblank #seq
+    double period;      // estimated refresh period, 0 while unknown
+    double last_wake;   // time of the most recent watcher wake-up
+    unsigned samples;   // accepted vblanks since the period became known
+    unsigned epoch;     // bumped whenever the estimate is restarted
+    uint64_t missed;    // vblanks the watcher itself slept through
+
+    double init_first, init_prev;
+    unsigned init_count;
+    unsigned outliers;
+};
+
+static void vbl_est_restart(struct vbl_est *e)
+{
+    e->period = 0;
+    e->samples = 0;
+    e->init_count = 0;
+    e->outliers = 0;
+    e->epoch++;
+}
+
+// Same estimator as shadPS4's VsyncLock: initial period from 30 consistent
+// intervals, then phase += 0.1*err, period += 0.002*err/n, outlier rejection,
+// and a restart after a long gap (display off, mode change).
+static void vbl_est_on_vblank(struct vbl_est *e, double t)
+{
+    e->last_wake = t;
+
+    if (e->period <= 0) {
+        // Rate unknown: count wake-ups so the index keeps moving forward.
+        e->seq++;
+        e->phase = t;
+        if (e->init_count == 0) {
+            e->init_first = e->init_prev = t;
+            e->init_count = 1;
+            return;
+        }
+        double dt = t - e->init_prev;
+        e->init_prev = t;
+        if (dt < 2 * VBL_NS_PER_MS || dt > 110 * VBL_NS_PER_MS) {
+            e->init_count = 0; // missed or spurious vblank, start over
+            return;
+        }
+        if (e->init_count >= 2) {
+            double mean = (e->init_prev - dt - e->init_first) / (e->init_count - 1);
+            if (fabs(dt - mean) > mean * 0.1) {
+                e->init_count = 0;
+                return;
+            }
+        }
+        if (++e->init_count > 30) {
+            e->period = (t - e->init_first) / (e->init_count - 1);
+            e->phase = t;
+            e->samples = 0;
+            e->outliers = 0;
+        }
+        return;
+    }
+
+    double since = t - e->phase;
+    if (since < e->period * 0.5)
+        return; // duplicate wake-up
+    double n = round(since / e->period);
+    if (n > 120) {
+        vbl_est_restart(e);
+        e->seq++;
+        e->phase = t;
+        e->init_first = e->init_prev = t;
+        e->init_count = 1;
+        return;
+    }
+    double predicted = e->phase + n * e->period;
+    double err = t - predicted;
+    if (fabs(err) > e->period * 0.25) {
+        if (++e->outliers > 8)
+            vbl_est_restart(e);
+        return;
+    }
+    e->outliers = 0;
+    e->phase = predicted + 0.1 * err;
+    e->period += 0.002 * err / n;
+    e->seq += (uint64_t)n;
+    if (n > 1)
+        e->missed += (uint64_t)n - 1;
+    e->samples++;
+}
+
+static bool vbl_est_valid(const struct vbl_est *e, double now)
+{
+    return e->period > 0 && e->samples >= 30 &&
+           now - e->last_wake < 250 * VBL_NS_PER_MS;
+}
+
+// ---------------------------------------------------------------------------
+// Present phase lock (MPV_VSYNC_LOCK=7): a port of shadPS4's VsyncLock and
+// AccurateTimer (drop-missed-intervals variant).
+//
+// shadPS4 paces its present thread with a timer and trims the timer interval
+// so that each present happens `margin` before the next host vblank. It never
+// waits for the vblank itself. Here the VO thread is the present thread: the
+// timer sleep happens at the start of each frame (before the swapchain image
+// is acquired and before rendering or uploading), and the lock is judged on
+// when the frame has been presented. shadPS4 takes the phase at the top of its
+// loop, where Present() follows right away; in mpv rendering and uploading
+// take a sizeable and variable part of the refresh cycle before the present,
+// so the present time is used instead. Everything else (target phase, gain,
+// slew limits, lock hysteresis, timer arithmetic) follows shadPS4.
+//
+// The functions below do not touch the OS, so the same code can be exercised
+// in isolation.
+
+struct vbl_pll {
+    // AccurateTimer
+    double interval;    // target interval of the current iteration (ns)
+    double total_wait;  // accumulated slack (ns); > 0 is slept at the next start
+    double start;       // start of the current iteration, 0 while stopped
+    unsigned dropped;   // whole intervals dropped since the last present
+    // VsyncLock
+    double margin;      // present this long before the host vblank (ns)
+    bool have_err;
+    double err;         // phase error of the latest present (ns), > 0: late
+    bool locked;
+    double err_avg;
+    unsigned good_frames, bad_frames;
+};
+
+// Stop the timer and forget the lock (VsyncLock's unlock()). Keeps the margin.
+static void vbl_pll_reset(struct vbl_pll *pl)
+{
+    double margin = pl->margin;
+    *pl = (struct vbl_pll){ .margin = margin };
+}
+
+// AccurateTimer::End() for the iteration that started at pl->start. Time lost
+// while blocked is not paid back with back-to-back iterations: whole missed
+// intervals are dropped and only the sub-interval remainder is kept, so the
+// iterations stay on their grid.
+static void vbl_pll_timer_end(struct vbl_pll *pl, double now)
+{
+    if (pl->start <= 0)
+        return;
+    pl->total_wait += pl->interval - (now - pl->start);
+    if (pl->total_wait < -pl->interval) {
+        double rest = fmod(pl->total_wait, pl->interval);
+        pl->dropped += (unsigned)llround((rest - pl->total_wait) / pl->interval);
+        pl->total_wait = rest;
+    }
+}
+
+// Which vblank to report for a present that the host shows at vblank
+// `shown` (the first one after the present; mailbox shows the newest image).
+//
+// Normally that is the vblank after the previous report, plus one for every
+// interval the timer dropped (a slot without a new image: the previous one is
+// shown again, a real repeat). A present that arrives after the vblank it was
+// meant for is usually replaced by the next frame before being shown (the
+// previous image is repeated and this one dropped, which leaves the video
+// position unchanged), so it is reported at the expected vblank for now. If
+// the next frame lands a vblank later instead of replacing it, the late frame
+// was shown after all: the next report then carries the real position and
+// the gap reaches vo.c one frame later. Only one report in a row is held
+// back like this. Several presents inside one refresh cycle (while the lock
+// is still acquiring) are reported as they are; vo.c resets its timing on a
+// repeated time.
+static int64_t vbl_pll_report(bool have_prev, int64_t prev_report, bool *prev_held,
+                              unsigned dropped, int64_t shown)
+{
+    int64_t expected = prev_report + 1 + (int64_t)dropped;
+    if (have_prev && !*prev_held && shown > expected) {
+        *prev_held = true;
+        return expected;
+    }
+    *prev_held = false;
+    return shown;
+}
+
+// Phase error of a present at time t, as in VsyncLock::NextInterval(): where
+// the present lies inside the host refresh cycle relative to `margin` before
+// the next vblank, wrapped to (-host/2, host/2]. > 0: too late.
+static double vbl_pll_phase_err(double t, double phase, double host, double margin)
+{
+    double since = fmod(t - phase, host);
+    if (since < 0)
+        since += host;
+    double target = host - fmod(margin, host);
+    double err = since - target;
+    if (err > host * 0.5) {
+        err -= host;
+    } else if (err <= -host * 0.5) {
+        err += host;
+    }
+    return err;
+}
+
+// VsyncLock's lock state, judged on the smoothed error so that jitter does not
+// flap it. Returns 1 when the lock was acquired, -1 when it was lost (then the
+// faster acquisition slew is allowed again), 0 otherwise.
+static int vbl_pll_update(struct vbl_pll *pl, double err)
+{
+    pl->err = err;
+    pl->have_err = true;
+    pl->err_avg += (err - pl->err_avg) * 0.05;
+    double abs_avg = fabs(pl->err_avg);
+    if (!pl->locked) {
+        pl->good_frames = abs_avg < 0.5 * VBL_NS_PER_MS ? pl->good_frames + 1 : 0;
+        if (pl->good_frames >= 60) {
+            pl->locked = true;
+            pl->bad_frames = 0;
+            return 1;
+        }
+    } else {
+        pl->bad_frames = abs_avg > 2.0 * VBL_NS_PER_MS ? pl->bad_frames + 1 : 0;
+        if (pl->bad_frames >= 30) {
+            pl->locked = false;
+            pl->good_frames = pl->bad_frames = 0;
+            return -1;
+        }
+    }
+    return 0;
+}
+
+// Interval for the iteration that has just started (VsyncLock::NextInterval):
+// proportional correction of the latest phase error, slew-limited to 0.5% of
+// the period while acquiring and 500 ppm once locked. One VO iteration per
+// host vblank, so the effective period is the host period.
+static double vbl_pll_next_interval(struct vbl_pll *pl, double host)
+{
+    double correction = 0;
+    if (pl->have_err) {
+        double max_step = host * (pl->locked ? 0.0005 : 0.005);
+        correction = fmin(fmax(pl->err * 0.1, -max_step), max_step);
+        pl->have_err = false;
+    }
+    return host - correction;
+}
+
+// State shared between the VO thread and the watcher thread. The watcher
+// blocks in a kernel wait that cannot be interrupted, so it is detached: it
+// holds its own reference (freed by the last owner) and a reference on this
+// module, released with FreeLibraryAndExitThread, so a libmpv unload cannot pull
+// the code out from under it.
+struct vbl_shared {
+    CRITICAL_SECTION lock;
+    CONDITION_VARIABLE cond;
+    volatile LONG refs;
+    volatile LONG stop;
+    HWND hwnd;
+    HMODULE module;
+    vbl_open_fn kmt_open;
+    vbl_wait_fn kmt_wait;
+    vbl_close_fn kmt_close;
+    struct vbl_est est; // protected by lock
+};
+
+static const char vbl_module_anchor = 0;
+
+static void vbl_unref(struct vbl_shared *s)
+{
+    if (InterlockedDecrement(&s->refs) == 0) {
+        DeleteCriticalSection(&s->lock);
+        free(s);
+    }
+}
+
+static void vbl_restart(struct vbl_shared *s)
+{
+    EnterCriticalSection(&s->lock);
+    vbl_est_restart(&s->est);
+    LeaveCriticalSection(&s->lock);
+    WakeAllConditionVariable(&s->cond);
+}
+
+static DWORD WINAPI vbl_thread(void *arg)
+{
+    struct vbl_shared *s = arg;
+    HMODULE module = s->module;
+
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+
+    HMONITOR monitor = NULL;
+    bool have_adapter = false;
+    struct vbl_kmt_wait wait_args = {0};
+    int64_t last_check = 0;
+
+    while (!InterlockedCompareExchange(&s->stop, 0, 0)) {
+        int64_t now = mp_time_ns();
+        if (!have_adapter || now - last_check >= 1000000000) {
+            last_check = now;
+            HMONITOR cur = MonitorFromWindow(s->hwnd, MONITOR_DEFAULTTONEAREST);
+            if (cur != monitor || !have_adapter) {
+                if (have_adapter) {
+                    struct vbl_kmt_close close_args = { wait_args.hAdapter };
+                    s->kmt_close(&close_args);
+                    have_adapter = false;
+                }
+                vbl_restart(s);
+                monitor = cur;
+
+                MONITORINFOEXW info = { .cbSize = sizeof(info) };
+                if (cur && GetMonitorInfoW(cur, (MONITORINFO *)&info)) {
+                    HDC dc = CreateDCW(NULL, info.szDevice, NULL, NULL);
+                    if (dc) {
+                        struct vbl_kmt_open open_args = { .hDc = dc };
+                        if (s->kmt_open(&open_args) == 0) {
+                            wait_args.hAdapter = open_args.hAdapter;
+                            wait_args.hDevice = 0;
+                            wait_args.VidPnSourceId = open_args.VidPnSourceId;
+                            have_adapter = true;
+                        }
+                        DeleteDC(dc);
+                    }
+                }
+                if (!have_adapter) {
+                    Sleep(1000);
+                    continue;
+                }
+            }
+        }
+
+        if (s->kmt_wait(&wait_args) != 0) {
+            struct vbl_kmt_close close_args = { wait_args.hAdapter };
+            s->kmt_close(&close_args);
+            have_adapter = false;
+            vbl_restart(s);
+            Sleep(100);
+            continue;
+        }
+
+        double t = (double)mp_time_ns();
+        EnterCriticalSection(&s->lock);
+        vbl_est_on_vblank(&s->est, t);
+        LeaveCriticalSection(&s->lock);
+        WakeAllConditionVariable(&s->cond);
+    }
+
+    if (have_adapter) {
+        struct vbl_kmt_close close_args = { wait_args.hAdapter };
+        s->kmt_close(&close_args);
+    }
+    vbl_unref(s);
+    FreeLibraryAndExitThread(module, 0);
+    return 0;
+}
+
+static struct vbl_shared *vbl_start(struct ra_ctx *ctx, HWND hwnd)
+{
+    HMODULE gdi = GetModuleHandleW(L"gdi32.dll");
+    if (!gdi)
+        gdi = LoadLibraryW(L"gdi32.dll");
+    if (!gdi)
+        return NULL;
+
+    vbl_open_fn kmt_open = (vbl_open_fn)(void (*)(void))
+        GetProcAddress(gdi, "D3DKMTOpenAdapterFromHdc");
+    vbl_wait_fn kmt_wait = (vbl_wait_fn)(void (*)(void))
+        GetProcAddress(gdi, "D3DKMTWaitForVerticalBlankEvent");
+    vbl_close_fn kmt_close = (vbl_close_fn)(void (*)(void))
+        GetProcAddress(gdi, "D3DKMTCloseAdapter");
+    if (!kmt_open || !kmt_wait || !kmt_close) {
+        MP_VERBOSE(ctx, "vsync-lock: D3DKMT vblank API unavailable\n");
+        return NULL;
+    }
+
+    struct vbl_shared *s = calloc(1, sizeof(*s));
+    if (!s)
+        return NULL;
+    InitializeCriticalSection(&s->lock);
+    InitializeConditionVariable(&s->cond);
+    s->refs = 2; // VO + watcher
+    s->hwnd = hwnd;
+    s->kmt_open = kmt_open;
+    s->kmt_wait = kmt_wait;
+    s->kmt_close = kmt_close;
+
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                            (LPCWSTR)&vbl_module_anchor, &s->module))
+    {
+        DeleteCriticalSection(&s->lock);
+        free(s);
+        return NULL;
+    }
+
+    HANDLE thread = CreateThread(NULL, 0, vbl_thread, s, 0, NULL);
+    if (!thread) {
+        FreeLibrary(s->module);
+        DeleteCriticalSection(&s->lock);
+        free(s);
+        return NULL;
+    }
+    CloseHandle(thread);
+
+    MP_VERBOSE(ctx, "vsync-lock: watching host vblank\n");
+    return s;
+}
+
+static void vbl_stop(struct vbl_shared *s)
+{
+    if (!s)
+        return;
+    InterlockedExchange(&s->stop, 1);
+    WakeAllConditionVariable(&s->cond);
+    vbl_unref(s);
+}
+
 struct priv {
     struct mpvk_ctx vk;
     struct mp_dxgi_factory_ctx dxgi_ctx;
+
+    // Host vblank lock (see above). VO thread only.
+    struct vbl_shared *vbl;
+    int vbl_mode;               // MPV_VSYNC_LOCK, see vbl_get_mode()
+    unsigned vbl_epoch;
+    bool vbl_have_prev;
+    uint64_t vbl_prev_target;
+    bool vbl_reported_active;
+
+    // Pre-render pacing (modes 4, 5): the vblank the last present targets.
+    // The wait for it happens at the start of the next frame.
+    bool pend_valid;
+    uint64_t pend_target;
+    unsigned pend_epoch;
+    int64_t pend_limit;
+
+    // Present phase lock (mode 7).
+    struct vbl_pll pll;
+    HANDLE pll_timer;
+    bool pll_timer_hires;
+    bool pll_held;              // the last report was held back (vbl_pll_report)
+
+    // Feedback for the swap that just finished.
+    bool fb_valid;
+    int64_t fb_time;
+    int64_t fb_period;
+    int64_t fb_skipped;
+
+    // Statistics, logged every 10 seconds.
+    int64_t st_begin;
+    unsigned st_frames, st_late, st_nofb, st_timeouts;
+    uint64_t st_skipped, st_missed_base;
+    double st_off_sum, st_off_max, st_wait_sum, st_wait_max, st_period;
+    unsigned st_pll_n;
+    double st_pll_err_sum, st_pll_err_absmax;
 };
 
+static void vbl_log_stats(struct ra_ctx *ctx, int64_t now, uint64_t missed)
+{
+    struct priv *p = ctx->priv;
+    if (!p->st_begin) {
+        p->st_begin = now;
+        p->st_missed_base = missed;
+        return;
+    }
+    if (now - p->st_begin < 10000000000LL)
+        return;
+    unsigned n = p->st_frames ? p->st_frames : 1;
+    MP_VERBOSE(ctx, "vsync-lock: host %.5f Hz, frames %u, late %u (vblanks skipped %llu), "
+               "present offset mean %.2f ms max %.2f ms, wait mean %.2f ms max %.2f ms, "
+               "no-feedback %u, timeouts %u, watcher missed %llu\n",
+               p->st_period > 0 ? 1e9 / p->st_period : 0.0, p->st_frames, p->st_late,
+               (unsigned long long)p->st_skipped,
+               p->st_off_sum / n / VBL_NS_PER_MS, p->st_off_max / VBL_NS_PER_MS,
+               p->st_wait_sum / n / VBL_NS_PER_MS, p->st_wait_max / VBL_NS_PER_MS,
+               p->st_nofb, p->st_timeouts,
+               (unsigned long long)(missed - p->st_missed_base));
+    if (p->vbl_mode == 7 || p->vbl_mode == 8) {
+        unsigned m = p->st_pll_n ? p->st_pll_n : 1;
+        MP_VERBOSE(ctx, "vsync-lock: host %.5f Hz, %s, phase err mean %+.3f ms, max %.3f ms "
+                   "(margin %.2f ms)\n",
+                   p->st_period > 0 ? 1e9 / p->st_period : 0.0,
+                   p->pll.locked ? "locked" : "acquiring",
+                   p->st_pll_err_sum / m / VBL_NS_PER_MS, p->st_pll_err_absmax / VBL_NS_PER_MS,
+                   p->pll.margin / VBL_NS_PER_MS);
+        p->st_pll_n = 0;
+        p->st_pll_err_sum = p->st_pll_err_absmax = 0;
+    }
+    p->st_begin = now;
+    p->st_missed_base = missed;
+    p->st_frames = p->st_late = p->st_nofb = p->st_timeouts = 0;
+    p->st_skipped = 0;
+    p->st_off_sum = p->st_off_max = p->st_wait_sum = p->st_wait_max = 0;
+}
+
+static void win_swap_buffers(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    struct vbl_shared *s = p->vbl;
+
+    p->fb_valid = false;
+    if (!s)
+        return;
+
+    int64_t arrive = mp_time_ns();
+    EnterCriticalSection(&s->lock);
+    struct vbl_est *e = &s->est;
+
+    if (!vbl_est_valid(e, (double)arrive)) {
+        uint64_t missed = e->missed;
+        LeaveCriticalSection(&s->lock);
+        if (p->vbl_reported_active) {
+            MP_VERBOSE(ctx, "vsync-lock: feedback lost\n");
+            p->vbl_reported_active = false;
+        }
+        p->vbl_have_prev = false;
+        p->st_nofb++;
+        vbl_log_stats(ctx, arrive, missed);
+        return;
+    }
+
+    if (e->epoch != p->vbl_epoch) {
+        p->vbl_epoch = e->epoch;
+        p->vbl_have_prev = false;
+    }
+
+    // The vblank interval the present was submitted in, and the first vblank
+    // after it: that is where this frame is latched.
+    double period = e->period;
+    double since = (double)arrive - e->phase;
+    int64_t k = (int64_t)floor(since / period);
+    uint64_t cur = (uint64_t)((int64_t)e->seq + k);
+    double offset = since - (double)k * period; // time since vblank #cur
+    uint64_t target = cur + 1;
+    // The watcher already woke for vblank #seq before we got here, so that one
+    // is definitely in the past even if the smoothed phase says otherwise.
+    if ((double)arrive >= e->last_wake && target <= e->seq)
+        target = e->seq + 1;
+    if (p->vbl_have_prev && target <= p->vbl_prev_target)
+        target = p->vbl_prev_target + 1;
+
+    // Pace the VO: one vblank per swap. Wait for the watcher to see #target.
+    unsigned epoch = e->epoch;
+    int64_t limit = arrive + (int64_t)((double)(target - cur) * period + 2 * period);
+    bool timed_out = false;
+    while (e->seq < target && e->epoch == epoch &&
+           !InterlockedCompareExchange(&s->stop, 0, 0))
+    {
+        int64_t now = mp_time_ns();
+        if (now >= limit) {
+            timed_out = true;
+            break;
+        }
+        DWORD ms = (DWORD)((limit - now) / 1000000) + 1;
+        SleepConditionVariableCS(&s->cond, &s->lock, ms);
+    }
+
+    bool ok = !timed_out && e->epoch == epoch && e->seq >= target && e->period > 0;
+    double shown = ok ? e->phase - (double)(e->seq - target) * e->period : 0;
+    double cur_period = e->period;
+    uint64_t missed = e->missed;
+    LeaveCriticalSection(&s->lock);
+
+    int64_t done = mp_time_ns();
+    if (!ok) {
+        p->vbl_have_prev = false;
+        if (timed_out)
+            p->st_timeouts++;
+        p->st_nofb++;
+        vbl_log_stats(ctx, done, missed);
+        return;
+    }
+
+    int64_t skipped = p->vbl_have_prev ? (int64_t)(target - p->vbl_prev_target) - 1 : 0;
+    p->vbl_prev_target = target;
+    p->vbl_have_prev = true;
+
+    p->fb_valid = true;
+    p->fb_time = llrint(shown);
+    p->fb_period = llrint(cur_period);
+    p->fb_skipped = skipped;
+
+    if (!p->vbl_reported_active) {
+        if (p->vbl_mode == 3) {
+            MP_VERBOSE(ctx, "vsync-lock: feedback active, host %.5f Hz\n", 1e9 / cur_period);
+        } else {
+            MP_VERBOSE(ctx, "vsync-lock: pacing active (feedback not reported), "
+                       "host %.5f Hz\n", 1e9 / cur_period);
+        }
+        p->vbl_reported_active = true;
+    }
+
+    double wait = (double)(done - arrive);
+    p->st_frames++;
+    if (skipped > 0) {
+        p->st_late++;
+        p->st_skipped += (uint64_t)skipped;
+    }
+    p->st_off_sum += offset;
+    p->st_off_max = MPMAX(p->st_off_max, offset);
+    p->st_wait_sum += wait;
+    p->st_wait_max = MPMAX(p->st_wait_max, wait);
+    p->st_period = cur_period;
+    vbl_log_stats(ctx, done, missed);
+}
+
+// Pre-render pacing (modes 4, 5). swap_buffers only decides which vblank the
+// present lands on and does not wait. The wait for that vblank is done at the
+// start of the next frame (check_visible runs at the top of draw_frame, before
+// the swapchain image is acquired and before any rendering or upload).
+//
+// vo.c wakes the core (which pulls the next frame through the filter chain,
+// e.g. an upscaler's GPU inference) right before draw_frame. With the wait at
+// the end of swap_buffers that wake-up and the next frame's rendering happen
+// back to back right after every vblank, so both GPU workloads start at the
+// same moment. With the wait here, the wake-up happens right after the
+// present and the filter chain gets the rest of the refresh cycle before the
+// VO renders again. The frames are rendered and presented at the same
+// vblanks either way.
+static void win_swap_buffers_pre(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    struct vbl_shared *s = p->vbl;
+
+    p->fb_valid = false;
+    p->pend_valid = false;
+    if (!s)
+        return;
+
+    int64_t arrive = mp_time_ns();
+    EnterCriticalSection(&s->lock);
+    struct vbl_est *e = &s->est;
+
+    if (!vbl_est_valid(e, (double)arrive)) {
+        uint64_t missed = e->missed;
+        LeaveCriticalSection(&s->lock);
+        if (p->vbl_reported_active) {
+            MP_VERBOSE(ctx, "vsync-lock: feedback lost\n");
+            p->vbl_reported_active = false;
+        }
+        p->vbl_have_prev = false;
+        p->st_nofb++;
+        vbl_log_stats(ctx, arrive, missed);
+        return;
+    }
+
+    if (e->epoch != p->vbl_epoch) {
+        p->vbl_epoch = e->epoch;
+        p->vbl_have_prev = false;
+    }
+
+    // Same target selection as win_swap_buffers.
+    double period = e->period;
+    double since = (double)arrive - e->phase;
+    int64_t k = (int64_t)floor(since / period);
+    uint64_t cur = (uint64_t)((int64_t)e->seq + k);
+    double offset = since - (double)k * period;
+    uint64_t target = cur + 1;
+    if ((double)arrive >= e->last_wake && target <= e->seq)
+        target = e->seq + 1;
+    if (p->vbl_have_prev && target <= p->vbl_prev_target)
+        target = p->vbl_prev_target + 1;
+
+    double shown = e->phase + ((double)target - (double)e->seq) * period;
+    unsigned epoch = e->epoch;
+    uint64_t missed = e->missed;
+    LeaveCriticalSection(&s->lock);
+
+    int64_t skipped = p->vbl_have_prev ? (int64_t)(target - p->vbl_prev_target) - 1 : 0;
+    p->vbl_prev_target = target;
+    p->vbl_have_prev = true;
+
+    p->pend_valid = true;
+    p->pend_target = target;
+    p->pend_epoch = epoch;
+    p->pend_limit = arrive + (int64_t)((double)(target - cur) * period + 2 * period);
+
+    p->fb_valid = true;
+    p->fb_time = llrint(shown);
+    p->fb_period = llrint(period);
+    p->fb_skipped = skipped;
+
+    if (!p->vbl_reported_active) {
+        MP_VERBOSE(ctx, "vsync-lock: %s (pre-render pacing), host %.5f Hz\n",
+                   p->vbl_mode >= 5 ? "feedback active" : "pacing active (feedback not reported)",
+                   1e9 / period);
+        p->vbl_reported_active = true;
+    }
+
+    p->st_frames++;
+    if (skipped > 0) {
+        p->st_late++;
+        p->st_skipped += (uint64_t)skipped;
+    }
+    p->st_off_sum += offset;
+    p->st_off_max = MPMAX(p->st_off_max, offset);
+    p->st_period = period;
+    vbl_log_stats(ctx, arrive, missed);
+}
+
+static bool win_check_visible(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    struct vbl_shared *s = p->vbl;
+    if (!s || !p->pend_valid)
+        return true;
+    p->pend_valid = false;
+
+    // Wait until the previously presented image has been latched, so that
+    // this frame cannot replace it in the mailbox.
+    int64_t begin = mp_time_ns();
+    bool timed_out = false;
+    EnterCriticalSection(&s->lock);
+    struct vbl_est *e = &s->est;
+    while (e->seq < p->pend_target && e->epoch == p->pend_epoch &&
+           !InterlockedCompareExchange(&s->stop, 0, 0))
+    {
+        int64_t now = mp_time_ns();
+        if (now >= p->pend_limit) {
+            timed_out = true;
+            break;
+        }
+        DWORD ms = (DWORD)((p->pend_limit - now) / 1000000) + 1;
+        SleepConditionVariableCS(&s->cond, &s->lock, ms);
+    }
+    LeaveCriticalSection(&s->lock);
+
+    if (timed_out) {
+        p->st_timeouts++;
+        p->vbl_have_prev = false;
+    }
+    double wait = (double)(mp_time_ns() - begin);
+    p->st_wait_sum += wait;
+    p->st_wait_max = MPMAX(p->st_wait_max, wait);
+    return true;
+}
+
+#ifndef CREATE_WAITABLE_TIMER_MANUAL_RESET
+#define CREATE_WAITABLE_TIMER_MANUAL_RESET 0x00000001
+#endif
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
+// AccurateSleep() with shadPS4's high-resolution waitable timer (Windows 10
+// 1803+), falling back to a plain waitable timer.
+static void vbl_pll_sleep(struct priv *p, double ns)
+{
+    if (ns <= 0)
+        return;
+    LARGE_INTEGER due = { .QuadPart = -(LONGLONG)(ns / 100.0) };
+    if (p->pll_timer && due.QuadPart < 0 &&
+        SetWaitableTimer(p->pll_timer, &due, 0, NULL, NULL, FALSE))
+    {
+        WaitForSingleObject(p->pll_timer, INFINITE);
+        return;
+    }
+    Sleep((DWORD)(ns / VBL_NS_PER_MS));
+}
+
+// One iteration of shadPS4's present loop: AccurateTimer::End() for the
+// previous iteration, AccurateTimer::Start() (sleep off the slack) and
+// SetTargetInterval(VsyncLock::NextInterval()) for this one. Without a settled
+// host vblank estimate the timer is stopped and nothing is held back.
+// Mode 7 runs it at the top of draw_frame, mode 8 right before the present.
+static void vbl_pll_tick(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    struct vbl_shared *s = p->vbl;
+    if (!s)
+        return;
+    struct vbl_pll *pl = &p->pll;
+
+    double now = (double)mp_time_ns();
+    EnterCriticalSection(&s->lock);
+    // shadPS4 wants 60 accepted vblanks before it uses the estimate.
+    bool valid = vbl_est_valid(&s->est, now) && s->est.samples >= 60;
+    double host = s->est.period;
+    LeaveCriticalSection(&s->lock);
+
+    if (!valid) {
+        if (pl->locked)
+            MP_VERBOSE(ctx, "vsync-lock: lost (no host vblank)\n");
+        vbl_pll_reset(pl);
+        return;
+    }
+
+    vbl_pll_timer_end(pl, now);
+    double begin = now;
+    if (pl->start > 0 && pl->total_wait > 0)
+        vbl_pll_sleep(p, fmin(pl->total_wait, 2 * host));
+    pl->start = (double)mp_time_ns();
+    pl->total_wait -= pl->start - begin;
+    pl->interval = vbl_pll_next_interval(pl, host);
+
+    double wait = pl->start - begin;
+    p->st_wait_sum += wait;
+    p->st_wait_max = MPMAX(p->st_wait_max, wait);
+}
+
+// Mode 7: the timer paces the whole VO iteration (it holds back rendering).
+static bool win_check_visible_pll(struct ra_ctx *ctx)
+{
+    vbl_pll_tick(ctx);
+    return true;
+}
+
+// Mode 8: the timer holds back only the present. Rendering, and with it the
+// core wake-up and the filter chain that vo.c triggers right before
+// draw_frame, run exactly as without the lock; the finished image waits for
+// its slot, like a flip request in shadPS4's present thread.
+static void win_pre_present_pll(struct ra_ctx *ctx)
+{
+    vbl_pll_tick(ctx);
+}
+
+// Mode 7, after the present: measure the phase for the lock and report the
+// vblank to vo.c (see vbl_pll_report()).
+static void win_swap_buffers_pll(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    struct vbl_shared *s = p->vbl;
+
+    p->fb_valid = false;
+    if (!s)
+        return;
+
+    int64_t arrive = mp_time_ns();
+    EnterCriticalSection(&s->lock);
+    struct vbl_est *e = &s->est;
+
+    if (!vbl_est_valid(e, (double)arrive) || e->samples < 60) {
+        uint64_t missed = e->missed;
+        LeaveCriticalSection(&s->lock);
+        if (p->vbl_reported_active) {
+            MP_VERBOSE(ctx, "vsync-lock: feedback lost\n");
+            p->vbl_reported_active = false;
+        }
+        p->vbl_have_prev = false;
+        p->pll_held = false;
+        p->st_nofb++;
+        vbl_log_stats(ctx, arrive, missed);
+        return;
+    }
+
+    if (e->epoch != p->vbl_epoch) {
+        p->vbl_epoch = e->epoch;
+        p->vbl_have_prev = false;
+    }
+
+    // The vblank the host shows this image at: the first one after the
+    // present (mailbox latches the newest image there). If the watcher has
+    // already woken for vblank #seq, that one is in the past even if the
+    // smoothed phase says otherwise.
+    double period = e->period;
+    double phase = e->phase;
+    uint64_t seq = e->seq;
+    double since = (double)arrive - phase;
+    int64_t k = (int64_t)floor(since / period);
+    int64_t cur = (int64_t)seq + k;
+    double offset = since - (double)k * period;
+    int64_t shown_at = cur + 1;
+    if ((double)arrive >= e->last_wake && shown_at <= (int64_t)seq)
+        shown_at = (int64_t)seq + 1;
+    uint64_t missed = e->missed;
+    LeaveCriticalSection(&s->lock);
+
+    int64_t report = vbl_pll_report(p->vbl_have_prev, (int64_t)p->vbl_prev_target,
+                                    &p->pll_held, p->pll.dropped, shown_at);
+    int64_t skipped = p->vbl_have_prev ? report - (int64_t)p->vbl_prev_target - 1 : 0;
+    bool late_present = p->pll_held;
+    p->pll.dropped = 0;
+    p->vbl_prev_target = (uint64_t)report;
+    p->vbl_have_prev = true;
+
+    double shown = phase + (double)(report - (int64_t)seq) * period;
+    p->fb_valid = true;
+    p->fb_time = llrint(shown);
+    p->fb_period = llrint(period);
+    p->fb_skipped = MPMAX(skipped, 0);
+
+    if (!p->vbl_reported_active) {
+        MP_VERBOSE(ctx, "vsync-lock: feedback active (present phase lock), host %.5f Hz\n",
+                   1e9 / period);
+        p->vbl_reported_active = true;
+    }
+
+    double err = vbl_pll_phase_err((double)arrive, phase, period, p->pll.margin);
+    switch (vbl_pll_update(&p->pll, err)) {
+    case 1:
+        MP_VERBOSE(ctx, "vsync-lock: locked to host %.4f Hz, margin %.2f ms\n",
+                   1e9 / period, p->pll.margin / VBL_NS_PER_MS);
+        break;
+    case -1:
+        MP_VERBOSE(ctx, "vsync-lock: phase error %.2f ms, re-acquiring\n",
+                   p->pll.err_avg / VBL_NS_PER_MS);
+        break;
+    }
+
+    // "late" counts presents that missed the vblank they were meant for
+    // (normally a repeat of the previous image followed by a dropped one),
+    // "vblanks skipped" the gaps actually reported to vo.c.
+    p->st_frames++;
+    if (late_present)
+        p->st_late++;
+    if (skipped > 0)
+        p->st_skipped += (uint64_t)skipped;
+    p->st_off_sum += offset;
+    p->st_off_max = MPMAX(p->st_off_max, offset);
+    p->st_period = period;
+    p->st_pll_n++;
+    p->st_pll_err_sum += err;
+    p->st_pll_err_absmax = fmax(p->st_pll_err_absmax, fabs(err));
+    vbl_log_stats(ctx, arrive, missed);
+}
+
+// MPV_VSYNC_LOCK_MARGIN_MS: how long before the host vblank to present in
+// mode 7 (1 - 50 ms, default 6 as in shadPS4).
+static double vbl_get_margin(void)
+{
+    const char *env = getenv("MPV_VSYNC_LOCK_MARGIN_MS");
+    long v = 6;
+    if (env && env[0]) {
+        char *end = NULL;
+        long x = strtol(env, &end, 10);
+        if (end != env && !*end)
