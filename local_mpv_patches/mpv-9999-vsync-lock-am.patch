+
+// MPV_VSYNC_LOCK selects how much of the lock is active, for isolating its
+// effects inside one build:
+//   0  off: no watcher thread, no pacing, no feedback (vo.c fallback path)
+//   1  watcher only: the vblank thread runs, swap_buffers does not wait,
+//      no feedback
+//   2  watcher + pacing: swap_buffers waits for the vblank, but get_vsync
+//      reports nothing (vo.c fallback path)
+//   3  full (default): watcher + pacing + feedback
+//   4  watcher + pre-render pacing: the wait moves from the end of
+//      swap_buffers to the start of the next frame, no feedback
+//   5  watcher + pre-render pacing + feedback
+//   7  shadPS4 present phase lock + feedback (for vulkan-swap-mode=mailbox):
+//      a timer before each frame, trimmed so that the present lands
+//      MPV_VSYNC_LOCK_MARGIN_MS before the host vblank; nothing waits for
+//      the vblank itself
+//   8  as 7, but the timer holds back only the present, not the rendering
+//      (the structure of shadPS4's present thread)
+static int vbl_get_mode(void)
+{
+    const char *env = getenv("MPV_VSYNC_LOCK");
+    if (!env || !env[0])
+        return 3;
+    char *end = NULL;
+    long v = strtol(env, &end, 10);
+    if (end == env || *end || v < 0 || v > 8 || v == 6)
+        return 3;
+    return (int)v;
+}
